{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "WebWorker"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true,
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"types": ["vite/client", "node"]
	},
	"include": ["src", "tests", "vite.config.ts"]
}
